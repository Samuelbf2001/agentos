{
  "name": "@agentos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pg": "./src/pg/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:pg": "tsx src/pg/migrate-pg.ts",
    "migrate-to-pg": "tsx src/pg/migrate-to-pg.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentos/shared": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.4"
  }
}
