# Guarda una copia con valores reales FUERA del repositorio, por ejemplo:
# C:\Users\samue\.agentos\notion-snapshot.env
# Nunca envíes este secreto por chat ni lo agregues a Git.
NOTION_SNAPSHOT_TOKEN=
NOTION_SNAPSHOT_TASKS_DATABASE_ID=
NOTION_SNAPSHOT_PROJECTS_DATABASE_ID=
# Se mantiene la versión que utiliza la conexión operativa actual.
NOTION_SNAPSHOT_API_VERSION=2022-06-28
# Tope de tamaño por adjunto descargado, en MB. Por defecto 50 si se omite.
NOTION_SNAPSHOT_MAX_ATTACHMENT_MB=50
