# AgentOS — variables de producción (EasyPanel).
#
# ESTE ARCHIVO SOLO DOCUMENTA NOMBRES. No lleva valores y no se despliega:
# los valores se cargan en el gestor de variables/secretos de EasyPanel,
# servicio por servicio, y nunca se commitean ni se hornean en la imagen.
#
# Servicio al que aplica cada bloque:
#   [api] agentos-api   [web] agentos-web   [db] agentos-db

# ---------------------------------------------------------------------------
# Acceso (api) — OBLIGATORIAS
# ---------------------------------------------------------------------------
# Contraseña compartida del equipo para entrar a la web. Si falta, la API
# arranca con la contraseña de desarrollo 'agentos-dev': fallo abierto conocido
# que se cierra en la segunda pasada de aplicación. Definirla SIEMPRE.
AGENTOS_SHARED_PASSWORD=
# Secreto para firmar los tokens de sesión. Debe ser aleatorio (>=32 bytes),
# distinto por entorno; rotarlo invalida todas las sesiones abiertas.
AGENTOS_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Datos (api) — motor de producción: PostgreSQL
# ---------------------------------------------------------------------------
# sqlite | postgres (alias: pg, supabase). Producción: postgres.
AGENTOS_DB_DRIVER=
# DSN del servicio interno agentos-db (usuario agentos, base propia). Nunca
# apunta a la base de WhatsAppHub. No debe aparecer en logs ni en respuestas.
AGENTOS_PG_URL=
# Solo con AGENTOS_DB_DRIVER=sqlite. Ruta DENTRO del contenedor, en el volumen
# persistente. Una ruta relativa se resuelve contra /app.
AGENTOS_DB_PATH=
# Raíz de artefactos generados por los agentes. Debe caer en el volumen
# persistente; si no se define, se usa /app/data/artifacts.
AGENTOS_ARTIFACTS_DIR=
# Límite de una imagen pegada en la descripción de una tarea
# (POST /api/uploads/images). Bytes; por defecto 10 MB. Las imágenes viven bajo
# <AGENTOS_ARTIFACTS_DIR>/uploads/<yyyy-mm>/, así que también necesitan volumen.
AGENTOS_UPLOAD_IMAGE_MAX_BYTES=

# ---------------------------------------------------------------------------
# Red y orígenes (api)
# ---------------------------------------------------------------------------
# Origen(es) del navegador permitidos por CORS, separados por coma. Con el
# proxy de agentos-web (mismo origen) basta con el dominio público de la web.
AGENTOS_WEB_ORIGIN=
# Base pública de la instalación (sin barra final). El asistente de IA la usa
# para dejar las referencias del prompt de ejecución en ABSOLUTO; si no se
# define, cae a https://agentos.sixteam.pro.
AGENTOS_PUBLIC_URL=
# Interfaz y puerto de escucha. La imagen ya trae 0.0.0.0 y 4300; solo se
# redefine si el puerto interno choca con otro servicio.
AGENTOS_API_HOST=
AGENTOS_API_PORT=

# ---------------------------------------------------------------------------
# Operación de los bucles (api)
# ---------------------------------------------------------------------------
# 1 o true = la API queda viva pero NO despacha runs ni corre el reaper. Es el
# modo de arranque pausado del primer despliegue y del diagnóstico.
AGENTOS_DISPATCHER_DISABLED=
# Periodo del reloj de recordatorios en milisegundos. Vacío = valor por defecto.
AGENTOS_NOTIFICATIONS_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Proveedores de modelo (api)
# ---------------------------------------------------------------------------
# Clave del proveedor que usan los runners ai_sdk y claude_code. Con otro
# proveedor se usa su variable equivalente (OPENAI_API_KEY, etc.).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Conector WhatsAppHub, solo lectura (api)
# ---------------------------------------------------------------------------
# URL interna del backend de WhatsAppHub (nombre de servicio Docker, no Internet).
# Además de Reuniones, alimentan los seis módulos internalizados de 2brain
# (Conversaciones, Notas de voz, Grabadora, Videos, Grafo, Agente 2brain).
AGENTOS_WHATSAPPHUB_URL=
# Clave dedicada a AgentOS con permisos mínimos. No se reutiliza otra existente.
AGENTOS_WHATSAPPHUB_KEY=

# ---------------------------------------------------------------------------
# Entorno (api, web)
# ---------------------------------------------------------------------------
# Zona horaria del contenedor. La imagen ya trae America/Bogota.
TZ=

# ---------------------------------------------------------------------------
# Proxy interno (web)
# ---------------------------------------------------------------------------
# Upstream al que nginx reenvía /api y /ws. En EasyPanel el nombre de servicio
# Swarm es <proyecto>_<servicio>. La imagen ya trae
# http://whatsfull_agentos-api:4300 como valor por defecto.
AGENTOS_API_UPSTREAM=
