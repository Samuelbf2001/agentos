# Proveedores LLM — SOLO nombres de variables; los valores jamás van a la DB ni a logs.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
GLM_API_KEY=

# ── Autenticación y sesiones ────────────────────────────────────────────────
# Contraseña compartida (MVP) + selección de persona.
# OBLIGATORIA con NODE_ENV=production: sin ella la API NO arranca (en desarrollo
# cae a 'agentos-dev' con un aviso).
AGENTOS_SHARED_PASSWORD=

# Secreto de firma de los tokens de sesión (HMAC-SHA256). Largo y aleatorio,
# p.ej. `openssl rand -hex 32`. OBLIGATORIO con NODE_ENV=production; en
# desarrollo se deriva de la contraseña. Rotarlo invalida TODAS las sesiones.
AGENTOS_SESSION_SECRET=

# Cookie de sesión con `Secure` (solo viaja por HTTPS). 1/true o 0/false; sin la
# variable se activa sola con NODE_ENV=production. Ponla a 1 detrás de cualquier
# proxy TLS. `HttpOnly` y `SameSite=Lax` van siempre.
AGENTOS_COOKIE_SECURE=

# Orígenes permitidos por CORS, lista separada por comas (jamás '*': la API
# viaja con credenciales). OBLIGATORIA con NODE_ENV=production; en desarrollo el
# default es http://localhost:4301. Un origen fuera de la lista no recibe
# access-control-allow-origin.
AGENTOS_WEB_ORIGIN=

# ── Zona horaria ────────────────────────────────────────────────────────────
# El corte del presupuesto DIARIO usa la hora LOCAL del proceso: sin TZ fijada,
# un contenedor en UTC corta a las 19:00 de Bogotá y el gasto "de hoy" no cuadra
# con el día del equipo. Fíjala SIEMPRE en el entorno (en producción el default
# es America/Bogota vía Dockerfile; nunca se fija desde código).
TZ=America/Bogota

# ── Persistencia ────────────────────────────────────────────────────────────
# Backend de datos: sqlite (default, cero fricción) | postgres.
# Con sqlite, nada de lo de abajo hace falta. Ver docs/POSTGRES.md.
AGENTOS_DB_DRIVER=sqlite

# Ruta de la base de datos SQLite (relativa a la raíz del repo)
AGENTOS_DB_PATH=./data/agentos.db

# Postgres/Supabase — OBLIGATORIA si AGENTOS_DB_DRIVER=postgres.
# Local con pgvector:  postgres://agentos:agentos@localhost:55432/agentos
# Supabase: usa el puerto 5432 (direct) para migraciones y 6543 (pooler) para la
# app — el pooler se autodetecta y apaga los prepared statements.
AGENTOS_PG_URL=

# El catálogo (org Sixteam, personas, agentes, metodologías, módulos,
# proveedores) se siembra SIEMPRE al arrancar, sea cual sea el entorno. Este
# flag solo controla la DEMO (org ACME + launch del módulo Consultoría, ~12
# tareas): 0/false/off la desactiva explícitamente. Sin la variable, el default
# depende de NODE_ENV — en producción NO se siembra la demo; en desarrollo sí
# (comportamiento histórico). En producción, deja esto vacío.
AGENTOS_SEED_DEMO=

# ── Búsqueda semántica del Context Hub (pgvector) ───────────────────────────
# SIN OPENAI_API_KEY todo sigue funcionando con FTS5/tsvector: la semántica es
# una mejora, nunca un requisito de arranque (degradación limpia).
AGENTOS_EMBEDDING_PROVIDER=          # openai | mock | none  (vacío = auto)
AGENTOS_EMBEDDING_MODEL=text-embedding-3-small
AGENTOS_EMBEDDING_DIM=1536
AGENTOS_EMBEDDING_BASE_URL=          # para proveedores compatibles con OpenAI

# Fuentes del proyecto (Fase 2): conector 2brain/WhatsAppHub.
# URL del backend (p.ej. https://whatsfull.sixteam.pro) y su WIKI_SYNC_KEY.
# La key JAMAS va en codigo, commits ni logs — solo aqui, por entorno.
AGENTOS_WHATSAPPHUB_URL=
AGENTOS_WHATSAPPHUB_KEY=
